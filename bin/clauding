#!/usr/bin/env node
// The `clauding` command, available on PATH inside every terminal the app
// opens. It sends one JSON line to the running app's socket and prints the
// reply. Usage:
//   clauding open <path or URL>   open a tab in the right panel
//   clauding panel show|hide      show or hide the right panel
//   clauding tabs                 list the open tabs of this session
//   clauding agent add <folder>   register an agent definition in the app
//                                 (--name and --emoji override what
//                                 the app would suggest from the folder)
//   clauding agent list           the agents registered in the app
//   clauding calendar add "<title>" [--date …] [--time 14:00-16:00]
//       [--daily|--weekly <day>|--biweekly <day>|--monthly] [--until …] [--project …]
//   clauding calendar list [--project …] [--from …] [--to …]
//   clauding calendar remove <id>  a project's own calendar (no ClickUp needed)
//
// And what the setup agent changes the app with (README: "The `clauding`
// command"):
//   clauding settings get [key] | settings set <key> <value>
//   clauding sessions count
//   clauding skills install-builtin
//   clauding integrations clickup status
//   clauding project inspect <ClickUp link>
//   clauding project add --json <file>
//   clauding project add --name "…" [--list <ClickUp link or id>] [--repo <folder>]… [--group "…"]
//   clauding project list
//   clauding repos find [folder …]
//   clauding repo inspect <folder>
//   clauding onboarding done
//
// And what the Clauding mod (builtin/mod/clauding-mod/) reports with, from
// inside a `claude` the app started — nobody types these:
//   clauding state <terminal id> <working|needs-answer|needs-permission|done|idle> [detail]
//   clauding session-info <terminal id>   (JSON: linked task, branch, switches)
//
// It is started as `clauding` on macOS (this file, executable, with the
// shebang above) and as `clauding.cmd` on Windows (the little batch file next
// to it, which runs `node` on this same file).
import fs from "node:fs";
import net from "node:net";
import path from "node:path";
import { commandChannelPath, defaultUserDataDirectory } from "../electron/lib/platformPaths.js";
import { CALENDAR_USAGE, parseCalendarArguments } from "../electron/lib/calendarCommands.js";

// The running app exports the address of its own channel into every terminal
// it opens (CLAUDING_SOCKET); the default below is where the installed app
// keeps it, for a shell that was not started by the app — a socket file
// inside the app's data folder on macOS, a named pipe on Windows.
const socketPath =
  process.env.CLAUDING_SOCKET ||
  commandChannelPath({ userDataDirectory: defaultUserDataDirectory() });
const [commandName, ...commandArguments] = process.argv.slice(2);

// One shape for every failure, so a session reading its own output cannot
// mistake a refusal for a success: "clauding: could not open — <reason>".
const FAILURE_VERBS = {
  open: "could not open",
  panel: "could not change the panel",
  tabs: "could not list the tabs",
  "agent add": "could not add agent",
  "agent list": "could not list the agents",
  "calendar add": "could not add to the calendar",
  "calendar list": "could not list the calendar",
  "calendar remove": "could not remove the calendar entry",
  calendar: "could not use the calendar",
  "settings get": "could not read the settings",
  "settings set": "could not change the setting",
  "sessions count": "could not count the sessions",
  "skills install-builtin": "could not install the built-in skills",
  integrations: "could not check the integration",
  "project inspect": "could not inspect the link",
  "project add": "could not add the project",
  "project list": "could not list the projects",
  "repos find": "could not look for repositories",
  "repo inspect": "could not inspect the repository",
  "onboarding done": "could not mark setup as done",
  state: "could not report the state",
  "session-info": "could not read the session info"
};

function failAndExit(reason) {
  const subcommand = `${commandName} ${commandArguments[0] || ""}`.trim();
  const verb = FAILURE_VERBS[subcommand] || FAILURE_VERBS[commandName] || "could not run the command";
  process.stderr.write(`clauding: ${verb} — ${reason}\n`);
  process.exit(1);
}

function usage() {
  process.stderr.write(
    "usage: clauding open <path or URL> | clauding panel show|hide | clauding tabs\n" +
      '       clauding agent add <definition folder> [--name "…"] [--emoji "…"] | clauding agent list\n' +
      "       clauding settings get [key] | clauding settings set <key> <value>\n" +
      "       clauding sessions count | clauding skills install-builtin | clauding integrations clickup status\n" +
      "       clauding project inspect <link> | clauding project add --json <file> | clauding project list\n" +
      '       clauding project add --name "…" [--list <link or id>] [--repo <folder>]… [--group "…"]\n' +
      "       clauding repos find [folder …] | clauding repo inspect <folder> | clauding onboarding done\n" +
      "       clauding state <terminal id> <state> [detail] | clauding session-info <terminal id>\n" +
      `       ${CALENDAR_USAGE}\n`
  );
  process.exit(1);
}

function resolvedPath(folder) {
  return path.resolve(process.cwd(), folder.startsWith("~/") ? path.join(process.env.HOME || "", folder.slice(2)) : folder);
}

// `project add --json <file>` reads the file here, where its relative path
// means something; the flags form builds the same draft.
function readProjectDraft(flagArguments) {
  if (flagArguments[0] === "--json") {
    if (flagArguments.length !== 2) {
      usage();
    }
    const filePath = resolvedPath(flagArguments[1]);
    let text = "";
    try {
      text = fs.readFileSync(filePath, "utf8");
    } catch (error) {
      failAndExit(`there is no readable file at ${filePath}.`);
    }
    try {
      const draft = JSON.parse(text);
      for (const repository of Array.isArray(draft.repositories) ? draft.repositories : []) {
        if (repository && typeof repository.localPath === "string" && repository.localPath) {
          repository.localPath = resolvedPath(repository.localPath);
        }
      }
      return draft;
    } catch (error) {
      failAndExit(`${filePath} is not valid JSON (${error.message}).`);
    }
  }
  const draft = { repositories: [] };
  for (let position = 0; position < flagArguments.length; position += 2) {
    const flag = flagArguments[position];
    const value = flagArguments[position + 1];
    if (typeof value !== "string") {
      usage();
    }
    if (flag === "--name") {
      draft.name = value;
    } else if (flag === "--list") {
      draft.projectLink = value;
    } else if (flag === "--repo") {
      draft.repositories.push({ localPath: resolvedPath(value) });
    } else if (flag === "--group") {
      draft.group = value;
    } else {
      usage();
    }
  }
  return draft;
}

// `--name "Release Notes Writer" --emoji 📝`: what the app would otherwise
// suggest from the definition folder. A flag always takes the next argument
// as its value, whatever it looks like.
const AGENT_FLAGS = { "--name": "name", "--emoji": "emoji" };

function readAgentFlags(flagArguments) {
  const values = {};
  for (let position = 0; position < flagArguments.length; position += 2) {
    const field = AGENT_FLAGS[flagArguments[position]];
    const value = flagArguments[position + 1];
    if (!field || typeof value !== "string") {
      usage();
    }
    values[field] = value;
  }
  return values;
}

function buildRequest() {
  const base = {
    terminalId: process.env.CLAUDING_TERMINAL_ID || null,
    cwd: process.cwd()
  };
  if (commandName === "open") {
    if (commandArguments.length !== 1) {
      usage();
    }
    return { ...base, command: "open", target: commandArguments[0] };
  }
  if (commandName === "panel") {
    if (commandArguments.length !== 1 || !["show", "hide"].includes(commandArguments[0])) {
      usage();
    }
    return { ...base, command: "panel", action: commandArguments[0] };
  }
  if (commandName === "tabs") {
    return { ...base, command: "tabs" };
  }
  if (commandName === "settings") {
    const [action, key, ...valueParts] = commandArguments;
    if (action === "get" && valueParts.length === 0) {
      return { ...base, command: "settings", action: "get", key: key || null };
    }
    if (action === "set" && key) {
      // The value may be several words ("answer in Polish") without quotes.
      return { ...base, command: "settings", action: "set", key, value: valueParts.join(" ") };
    }
    return usage();
  }
  if (commandName === "sessions" && commandArguments[0] === "count" && commandArguments.length === 1) {
    return { ...base, command: "sessions", action: "count" };
  }
  if (commandName === "skills" && commandArguments[0] === "install-builtin" && commandArguments.length === 1) {
    return { ...base, command: "skills", action: "install-builtin" };
  }
  if (commandName === "integrations" && commandArguments.length === 2) {
    return { ...base, command: "integrations", service: commandArguments[0], action: commandArguments[1] };
  }
  if (commandName === "project") {
    const [action, ...rest] = commandArguments;
    if (action === "list" && rest.length === 0) {
      return { ...base, command: "project", action: "list" };
    }
    if (action === "inspect" && rest.length === 1) {
      return { ...base, command: "project", action: "inspect", link: rest[0] };
    }
    if (action === "add" && rest.length > 0) {
      return { ...base, command: "project", action: "add", board: readProjectDraft(rest) };
    }
    return usage();
  }
  if (commandName === "repos" && commandArguments[0] === "find") {
    return { ...base, command: "repos", action: "find", roots: commandArguments.slice(1).map(resolvedPath) };
  }
  if (commandName === "repo" && commandArguments[0] === "inspect" && commandArguments.length === 2) {
    return { ...base, command: "repo", action: "inspect", path: resolvedPath(commandArguments[1]) };
  }
  if (commandName === "onboarding" && commandArguments[0] === "done" && commandArguments.length === 1) {
    return { ...base, command: "onboarding", action: "done" };
  }
  if (commandName === "state" && (commandArguments.length === 2 || commandArguments.length === 3)) {
    const [target, state, detail] = commandArguments;
    return { ...base, command: "state", target, state, detail: detail || "" };
  }
  if (commandName === "session-info" && commandArguments.length === 1) {
    return { ...base, command: "session-info", target: commandArguments[0] };
  }
  if (commandName === "calendar") {
    try {
      return { ...base, command: "calendar", ...parseCalendarArguments(commandArguments) };
    } catch (error) {
      return failAndExit(error.message);
    }
  }
  if (commandName === "agent") {
    const [action, ...rest] = commandArguments;
    if (action === "list") {
      if (rest.length > 0) {
        usage();
      }
      return { ...base, command: "agent", action: "list" };
    }
    if (action === "add") {
      const [definitionFolder, ...flagArguments] = rest;
      if (!definitionFolder) {
        usage();
      }
      return { ...base, command: "agent", action: "add", definitionFolder, ...readAgentFlags(flagArguments) };
    }
    return usage();
  }
  return usage();
}

const request = buildRequest();
const connection = net.connect(socketPath);
let reply = "";
connection.setEncoding("utf8");
connection.on("connect", () => {
  connection.write(`${JSON.stringify(request)}\n`);
});
connection.on("data", (chunk) => {
  reply += chunk;
  const newlineIndex = reply.indexOf("\n");
  if (newlineIndex === -1) {
    return;
  }
  let answer = null;
  try {
    answer = JSON.parse(reply.slice(0, newlineIndex));
  } catch (error) {
    connection.end();
    failAndExit("the app sent an answer this command could not read.");
    return;
  }
  connection.end();
  if (answer.ok) {
    process.stdout.write(`${answer.message}\n`);
    process.exit(0);
  }
  failAndExit(answer.error || "the app refused the request without a reason.");
});
connection.on("error", (error) => {
  if (error.code === "ENOENT" || error.code === "ECONNREFUSED") {
    failAndExit(`the Clauding app is not running (no socket at ${socketPath}).`);
  } else {
    failAndExit(error.message);
  }
});
// Asking ClickUp about a whole folder of lists takes a while; everything
// else answers at once.
const SLOW_COMMANDS = ["project", "integrations", "repos", "repo", "sessions"];
const answerSeconds = SLOW_COMMANDS.includes(commandName) ? 120 : 5;
connection.setTimeout(answerSeconds * 1000, () => {
  failAndExit(`the app did not answer within ${answerSeconds} s.`);
});
